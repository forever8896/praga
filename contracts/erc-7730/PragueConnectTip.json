{
  "$schema": "https://eips.ethereum.org/assets/eip-7730/erc7730-v1.schema.json",
  "context": {
    "$id": "PragueConnectTip — sealed gift",
    "contract": {
      "deployments": [
        { "chainId": 84532, "address": "0x42F035e3A94A232e3240fF91371d51e2ee7bdd91" }
      ],
      "abi": [
        {
          "type": "function",
          "name": "tip",
          "stateMutability": "payable",
          "inputs": [
            { "name": "stealthRecipient", "type": "address" },
            { "name": "ephemeralPubKey", "type": "bytes" },
            { "name": "viewTag", "type": "bytes1" },
            { "name": "memo", "type": "string" }
          ],
          "outputs": []
        },
        {
          "type": "function",
          "name": "tipWithReferral",
          "stateMutability": "payable",
          "inputs": [
            { "name": "recipientStealth", "type": "address" },
            { "name": "recipientEphPubKey", "type": "bytes" },
            { "name": "recipientViewTag", "type": "bytes1" },
            { "name": "inviterStealth", "type": "address" },
            { "name": "inviterEphPubKey", "type": "bytes" },
            { "name": "inviterViewTag", "type": "bytes1" },
            { "name": "memo", "type": "string" }
          ],
          "outputs": []
        }
      ]
    }
  },
  "metadata": {
    "owner": "PragueConnect",
    "info": {
      "legalName": "PragueConnect — by the hand of",
      "url": "https://pragueconnect-azure.vercel.app",
      "deploymentDate": "2026-05-08"
    },
    "constants": {
      "scopelift_announcer": "0x55649E01B5Df198D18D95b5cc5051630cfD45564"
    }
  },
  "display": {
    "formats": {
      "tip(address,bytes,bytes1,string)": {
        "intent": "Send a sealed private gift",
        "fields": [
          {
            "path": "stealthRecipient",
            "label": "Sealed delivery address",
            "format": "addressName",
            "params": { "types": ["wallet"] }
          },
          {
            "path": "memo",
            "label": "A word with it",
            "format": "raw"
          },
          {
            "path": "$.tx.value",
            "label": "Amount",
            "format": "tokenAmount",
            "params": { "tokenPath": null, "nativeCurrencyAddress": null }
          }
        ],
        "required": ["stealthRecipient", "$.tx.value"],
        "excluded": ["ephemeralPubKey", "viewTag"]
      },
      "tipWithReferral(address,bytes,bytes1,address,bytes,bytes1,string)": {
        "intent": "Send a sealed gift with a finder's mark",
        "fields": [
          {
            "path": "recipientStealth",
            "label": "Sealed delivery — recipient",
            "format": "addressName",
            "params": { "types": ["wallet"] }
          },
          {
            "path": "inviterStealth",
            "label": "Finder's mark — to your inviter",
            "format": "addressName",
            "params": { "types": ["wallet"] }
          },
          {
            "path": "memo",
            "label": "A word with it",
            "format": "raw"
          },
          {
            "path": "$.tx.value",
            "label": "Total amount",
            "format": "tokenAmount",
            "params": { "tokenPath": null, "nativeCurrencyAddress": null }
          }
        ],
        "required": ["recipientStealth", "inviterStealth", "$.tx.value"],
        "excluded": ["recipientEphPubKey", "recipientViewTag", "inviterEphPubKey", "inviterViewTag"]
      }
    }
  }
}
