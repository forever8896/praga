# Skol — environment variables. Copy to .env.local and fill in.

# --- Privy (embedded wallet)
# https://dashboard.privy.io/ → create app → copy App ID
NEXT_PUBLIC_PRIVY_APP_ID=

# --- Pimlico (paymaster + bundler for sponsored tx)
# https://dashboard.pimlico.io/apikeys
NEXT_PUBLIC_PIMLICO_API_KEY=

# --- L2 RPCs
NEXT_PUBLIC_BASE_RPC_URL=https://mainnet.base.org
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Default chain ID — 8453 for Base mainnet, 84532 for Base Sepolia.
NEXT_PUBLIC_DEFAULT_CHAIN_ID=84532

# --- NameStone (server-side only — keep this secret)
# https://namestone.com → request API key, point at parent skol.eth
NAMESTONE_API_KEY=
NEXT_PUBLIC_NAMESTONE_DOMAIN=skol.eth

# --- Skol's deployed contracts (filled in after `forge script script/Deploy.s.sol`)
NEXT_PUBLIC_SKOL_ESCROW_ADDRESS=
