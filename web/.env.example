# PragueConnect — environment variables. Copy to .env.local and fill in.

# --- Privy (embedded wallet)
# https://dashboard.privy.io/ → create app → copy App ID
NEXT_PUBLIC_PRIVY_APP_ID=
# Server-only — used by backend routes to verify Privy identity tokens.
PRIVY_APP_SECRET=

# --- Pimlico (paymaster + bundler for sponsored tx — currently unused, ready for upgrade)
# https://dashboard.pimlico.io/apikeys
NEXT_PUBLIC_PIMLICO_API_KEY=

# --- L2 RPCs
NEXT_PUBLIC_BASE_RPC_URL=https://mainnet.base.org
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Default chain ID — 8453 for Base mainnet, 84532 for Base Sepolia.
NEXT_PUBLIC_DEFAULT_CHAIN_ID=84532

# --- Parent ENS name (historical var name from NameStone era)
NEXT_PUBLIC_NAMESTONE_DOMAIN=pragueconnect.eth

# --- CCIP-Read resolver signer (server-only)
# Private key whose address is registered as a signer on PragueConnectResolver.sol
# Used by /api/ccip/[sender]/[data] to sign gateway responses.
PC_RESOLVER_SIGNER_KEY=

# --- PragueConnect's deployed contracts (filled in after `forge script ...`)
NEXT_PUBLIC_PRAGUECONNECT_ESCROW_ADDRESS=
NEXT_PUBLIC_PRAGUECONNECT_TIP_ADDRESS=

# --- Vercel KV (resolver persistence — auto-injected by Vercel after Storage → KV)
# Without these, the resolver falls back to an in-memory overlay that does NOT
# survive lambda recycles. Required for any multi-user public testing.
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=

# --- Faucet drip wallet (server-only, optional but recommended for public testing)
# Private key for an EOA funded with Base Sepolia ETH; /api/faucet-drip sends
# ~0.005 ETH to authenticated users on first tip if their balance is empty.
# Rate-limited to one drip per address per 24h via KV.
PC_FAUCET_KEY=

# --- Swarm (optional — render & pin profile pages to *.eth.limo)
# Required to wire Swarm-resolver contenthash into ENS subnames so each
# `<name>.pragueconnect.eth.limo` page is served from Swarm rather than Vercel.
# See README "Swarm contenthash publishing".
# SWARM_BEE_URL=http://localhost:1633
# SWARM_POSTAGE_BATCH_ID=
